APP_NAME="M.Y. Business Hotel HR V2"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Set a real local PostgreSQL URL; CHANGE_ME is intentionally rejected.
DATABASE_URL=
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Optional monthly report email. Leave empty to keep reports local-only.
REPORT_EMAIL_TO=
REPORT_SMTP_HOST=
REPORT_SMTP_PORT=587
REPORT_SMTP_USERNAME=
REPORT_SMTP_PASSWORD=
REPORT_SMTP_STARTTLS=true
# Optional: expose interactive API docs at /docs (default off on the hotel laptop).
APP_EXPOSE_DOCS=false

# Optional local AI assistant (Ollama on this computer only; no cloud AI).
# Model used by the assistant. OLLAMA_MODEL is accepted as an alias. Restart the app after changing.
# LOCAL_AI_MODEL=qwen2.5:3b
# Address of the local model server; only localhost, 127.0.0.1 and ::1 are ever used.
# LOCAL_AI_BASE_URL=http://127.0.0.1:11434
